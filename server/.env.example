# Firebase Admin (download from Firebase Console > Project Settings > Service Accounts)
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# WPScan API (free at wpscan.com/api)
WPSCAN_API_TOKEN=your-wpscan-api-token

# GitHub (for triggering Playwright tests via GitHub Actions)
GITHUB_TOKEN=your-github-personal-access-token
GITHUB_REPO_OWNER=your-github-username
GITHUB_REPO_NAME=patchproof-mvp

# API Security
API_SECRET_KEY=generate-a-random-string-here

# Server
PORT=3001
